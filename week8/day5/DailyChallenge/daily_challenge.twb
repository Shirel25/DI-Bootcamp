      <aliases enabled='yes' />
      <column caption='2020 Units Sold' datatype='integer' name='[2020_units_sold]' role='measure' type='quantitative' />
      <column caption='2021 Start Stock' datatype='integer' name='[2021_start_stock]' role='measure' type='quantitative' />
      <column caption='Abc 2021' datatype='string' name='[ABC_2021]' role='dimension' type='nominal' />
      <column caption='Advertisement Costs' datatype='real' name='[Advertisement_Costs]' role='measure' type='quantitative' />
      <column caption='Inventory Turnover Rate' datatype='real' name='[Calculation_1623547730562633728]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([2020_units_sold]) / sum([2021_start_stock])' />
      </column>
      <column caption='Total Unit Cost' datatype='real' name='[Calculation_1623547730563780609]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Raw_Material_Cost]) + &#13;&#10;sum([Factory_Labor_Costs]) + &#13;&#10;sum([Factory_Equipment_Rent_Costs]) + &#13;&#10;sum([Distribution_Costs]) + &#13;&#10;sum([Advertisement_Costs])' />
      </column>
      <column caption='Unit Profit' datatype='real' name='[Calculation_1623547730564616194]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Retail_Price]) - [Calculation_1623547730563780609]' />
      </column>
      <column caption='Estimated Total Profit' datatype='real' name='[Calculation_1623547730565005315]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1623547730564616194] * sum([2020_units_sold])' />
      </column>
      <column caption='Customer Country' datatype='string' name='[Customer_Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column caption='Distribution Costs' datatype='real' name='[Distribution_Costs]' role='measure' type='quantitative' />
