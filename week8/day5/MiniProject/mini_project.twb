  <actions>
    <action caption='Job Category' name='[Action1_094A33C22C15487080DA06CD8D6C0C66]'>
      <activation type='on-select' />
      <source dashboard='Data Job Market Insights – Trends, Skills &amp; Opportunities' type='sheet' worksheet='Relevant Data Job Postings' />
      <link caption='Job Category' delimiter=',' escape='\' expression='tsl:Data%20Job%20Market%20Insights%20%E2%80%93%20Trends%2C%20Skills%20%26%20Opportunities?' include-null='true' multi-select='true' url-escape='true' />
      <command command='tsc:tsl-filter'>
        <param name='exclude' value='Relevant Data Job Postings' />
        <param name='target' value='Data Job Market Insights – Trends, Skills &amp; Opportunities' />
      </command>
    </action>
    <action caption='Filter 1 (generated)' name='[Action2_A9D072F63AAA40BD826A7708743A7362]'>
      <activation auto-clear='true' type='on-select' />
      <source dashboard='Data Job Market Insights – Trends, Skills &amp; Opportunities' type='sheet' worksheet='Top 10 Job Locations for Data Roles' />
      <command command='tsc:tsl-filter'>
        <param name='special-fields' value='all' />
        <param name='target' value='Data Job Market Insights – Trends, Skills &amp; Opportunities' />
      </command>
    </action>
    <action caption='Filter 2 (generated)' name='[Action3_B427C049C7E84328BDAC1A6F9EFDCDE8]'>
      <activation auto-clear='true' type='on-select' />
      <source dashboard='Data Job Market Insights – Trends, Skills &amp; Opportunities' type='sheet' worksheet='Top 15 Hiring Companies for Data Jobs' />
      <command command='tsc:tsl-filter'>
        <param name='special-fields' value='all' />
        <param name='target' value='Data Job Market Insights – Trends, Skills &amp; Opportunities' />
      </command>
    </action>
    <action caption='Filter by month' name='[Action4_C93337D5690642669A4A1CA47A71BB81]'>
      <activation auto-clear='true' type='on-select' />
      <source dashboard='Data Job Market Insights – Trends, Skills &amp; Opportunities' type='sheet' worksheet='Monthly Trends in Data Job Postings' />
      <link caption='Filter by month' delimiter=',' escape='\' expression='tsl:Data%20Job%20Market%20Insights%20%E2%80%93%20Trends%2C%20Skills%20%26%20Opportunities?%5Bfederated.1r9pxik0n1urr917hacfc0pnc1tu%5D.%5BCalculation_4041699254987132929%5D~s0=&lt;[federated.1r9pxik0n1urr917hacfc0pnc1tu].[Calculation_4041699254987132929]~na&gt;' include-null='true' multi-select='true' url-escape='true' />
      <command command='tsc:tsl-filter'>
        <param name='exclude' value='Monthly Trends in Data Job Postings' />
        <param name='target' value='Data Job Market Insights – Trends, Skills &amp; Opportunities' />
      </command>
    </action>
    <datasources>
      <datasource caption='Sheet1 (job_postings_cleaned)' name='federated.1r9pxik0n1urr917hacfc0pnc1tu' />
    </datasources>
    <datasource-dependencies datasource='federated.1r9pxik0n1urr917hacfc0pnc1tu'>
      <column caption='Clean Job Title' datatype='string' name='[Calculation_4041699254987132929]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS(LOWER([Job Title]), &quot;analyst&quot;) &#13;&#10;OR CONTAINS(LOWER([Job Title]), &quot;analytics&quot;) THEN &quot;Data Analyst&quot;&#13;&#10;ELSEIF CONTAINS(LOWER([Job Title]), &quot;scientist&quot;) &#13;&#10;OR CONTAINS(LOWER([Job Title]), &quot;science&quot;) THEN &quot;Data Scientist&quot;&#13;&#10;ELSEIF CONTAINS(LOWER([Job Title]), &quot;engineer&quot;) THEN &quot;Data Engineer&quot;&#13;&#10;ELSEIF CONTAINS(LOWER([Job Title]), &quot;machine learning&quot;) THEN &quot;ML Engineer&quot;&#13;&#10;ELSE &quot;Other&quot;&#13;&#10;END' />
      </column>
    </datasource-dependencies>
  </actions>
